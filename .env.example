# Copy to .env and fill in. The server reads it on start.

# OmniRoute (or any OpenAI-compatible gateway). Get the key from the OmniRoute dashboard -> Endpoints.
OMNIROUTE_URL=http://localhost:20128/v1
OMNIROUTE_API_KEY=
# "auto" lets OmniRoute pick among your connected providers, or name one, e.g. openai/gpt-4o-mini
OMNIROUTE_MODEL=auto

# Where the coach server listens. Keep 127.0.0.1 unless you know you want it on your network.
PORT=8787
HOST=127.0.0.1
